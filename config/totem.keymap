//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        /* Left-hand home-row mods: hold activates when combined with right-half keys (positions in map order, 0-37). */

        hml: left_hand_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
        };

        /* Right-hand home-row mods: hold activates when combined with left-half keys (not 31 — that is RBKT on the right). */

        hmr: right_hand_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 32 33 34>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp ENTER>;
            key-positions = <29 28>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <23 22>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                  &kp Q  &kp W        &kp E         &kp R           &kp T           &kp Y  &kp U      &kp I         &kp O        &kp P
                  &kp A  &hml LALT S  &hml LCTRL D  &kp F           &kp G           &kp H  &kp J      &hmr RCTRL K  &hmr RALT L  &kp SEMI
&kp LEFT_BRACKET  &kp Z  &kp X        &kp C         &kp V           &kp B           &kp N  &kp M      &kp COMMA     &kp DOT      &kp SQT   &kp RBKT
                                      &to 3         &sk LEFT_SHIFT  &sk LEFT_GUI    &to 1  &kp SPACE  &mo 2
            >;
        };

        num_arr {
            bindings = <
        &kp ESCAPE  &kp UNDERSCORE  &kp UP     &kp PLUS   &kp LBKT    &kp RBKT      &kp NUMBER_7  &kp NUMBER_8  &kp N9        &kp PAGE_UP
        &kp TAB     &kp LEFT        &kp DOWN   &kp RIGHT  &kp LPAR    &kp RPAR      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PAGE_DOWN
&trans  &kp TILDE   &kp MINUS       &kp ENTER  &kp EQUAL  &kp LBRC    &kp RBRC      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PRINTSCREEN  &kp BACKSPACE
                                    &kp GRAVE  &kp COMMA  &to 0       &kp LEFT_GUI  &kp DOT       &kp NUMBER_0
            >;
        };

        mouse_func {
            bindings = <
        &kp C_VOLUME_UP    &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &msc SCRL_LEFT     &trans         &trans     &trans      &trans      &kp C_BRIGHTNESS_INC
        &kp C_VOLUME_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT    &kp PAGE_UP    &mkp LCLK  &mkp RCLK   &mkp MCLK   &kp C_BRIGHTNESS_DEC
&trans  &kp K_MUTE         &trans          &trans          &trans           &trans             &kp PAGE_DOWN  &trans     &kp K_PREV  &kp K_NEXT  &trans                &trans
                                           &trans          &trans           &trans             &none          &trans     &none
            >;
        };

        sym {
            bindings = <
       &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR     &kp PERCENT      &kp CARET         &kp AMPERSAND  &kp ASTERISK  &kp SQT            &none
       &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4   &kp NUMBER_5     &kp NUMBER_6      &kp NUMBER_7   &kp NUMBER_8  &kp NUMBER_9       &kp NUMBER_0
&none  &none            &none         &kp PIPE      &kp BACKSLASH  &kp LESS_THAN    &kp GREATER_THAN  &kp SLASH      &kp QUESTION  &kp DOUBLE_QUOTES  &none         &none
                                      &none         &none          &none            &to 0             &none          &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
